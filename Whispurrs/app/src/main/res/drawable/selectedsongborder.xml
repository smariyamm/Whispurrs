<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFAF80" /> <!-- Outer border -->
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Padding between outer and inner squares -->
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFDF7B" /> <!-- Background between borders -->
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Inner visible square -->
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFF4B3" /> <!-- Inner visible square -->

        </shape>
    </item>
</layer-list>
